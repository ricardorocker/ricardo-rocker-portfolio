# Environment Variables
# Copy this file to `.env.local` and fill in the values.
# Variables prefixed with `NEXT_PUBLIC_` are exposed to the browser.

# --- Public contact / social URLs (browser-exposed) ---

# URL of your public Upwork freelancer profile.
# Used by: Hero CTA, Contact page, Footer, Case studies CTA
NEXT_PUBLIC_UPWORK_URL=https://www.upwork.com/freelancers/ricardorocker

# Full LinkedIn URL (https://www.linkedin.com/in/<slug>/)
# Used by: Footer, Contact page
NEXT_PUBLIC_LINKEDIN_URL=https://www.linkedin.com/in/ricardo-s-rocker/

# Full GitHub URL (https://github.com/<username>)
# Used by: Footer, Contact page
NEXT_PUBLIC_GITHUB_URL=https://github.com/ricardorocker

# Email shown on the Contact page and used in mailto: links.
# Replace with the inbox you actually read (Gmail/Proton/custom domain).
NEXT_PUBLIC_CONTACT_EMAIL=contact@ricardorocker.com
